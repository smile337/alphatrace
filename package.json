{
  "name": "alphatrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @alphatrace/web",
    "dev:ensure": "powershell -ExecutionPolicy Bypass -File scripts/dev-ensure.ps1",
    "dev:watch": "powershell -ExecutionPolicy Bypass -File scripts/dev-watch.ps1",
    "dev:api": "npm run dev --workspace @alphatrace/api",
    "dev:bot": "npm run dev --workspace @alphatrace/bot",
    "dev:worker": "npm run dev --workspace @alphatrace/worker",
    "prisma:validate": "prisma validate --schema packages/db/prisma/schema.prisma",
    "verify:subscription": "tsx apps/api/src/verify-subscription-persistence.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/sensible": "^6.0.3",
    "@prisma/client": "^6.8.2",
    "bullmq": "^5.52.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "next": "^15.3.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.4"
  }
}
